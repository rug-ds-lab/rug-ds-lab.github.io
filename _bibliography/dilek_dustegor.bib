@inproceedings{0656f876cacc4accabe8d75774c78408,
  title     = "Science-Twins: Digital Twins for Interactive Lecture Demonstrations",
  abstract  = "Digital twins are increasingly utilized across various sectors, including industry and education, due to their significant advantages in our increasingly digital world. Particularly in education, digital twins offer interactive and comprehensive learning experiences. This paper explores the benefits of integrating digital twin technology into classroom settings and proposes a proof-of-concept application suitable for both in-person and online learning environments. The application aims to enhance student engagement by providing interactive tutorials and experiments with the ability to replay digital twin simulations. By offering real-time data observation alongside simulation-based learning, the application enriches the learning experience. Moreover, the paper also provides a brief literature review on the topic of digital twins in smart classrooms.",
  keywords  = "Active Learning, Digital Twins, Education, Smart Classroom",
  author    = "Davide Rigoni and Dilek D{\"u}{\c s}teg{\"o}r",
  note      = "Publisher Copyright: {\textcopyright} 2024 Copyright for this paper by its authors.; 1st International Workshop on Distributed Digital Twins, DiDit 2024 ; Conference date: 17-06-2024",
