@inbook{d7a4673158864dad8fe73354545d1fb1,
  title     = "Digital Twins: An enabler for digital transformation",
  abstract  = "Digital Twins are a virtual representation of anything of value for an organization thatcreate a link between the real and virtual worlds by a continuous bidirectional data/information exchange. In this chapter we present the origins of the concept and how itevolved with the advent of new technological trends. In addition, we describe the maincharacteristics of a Digital Twin, the benefits of its use, and real-world examples of theusage of digital twins{\textquoteright}. Finally, the challenges for its adoption, and the elements to beconsidered for managing the quality of the Digital Twin are presented to give a completeoverview of this new technology",
  author    = "Andr{\'e}s Tello and Viktoriya Degeler",
  year      = "2021",
